# API
APP_ENV=development
TENANCY_MODE=single            # single | multi
API_ADDR=:8080
APP_ORIGINS=http://localhost:3000
APP_TIMEZONE=Asia/Makassar
DATABASE_URL=postgres://newsekolah:newsekolah@127.0.0.1:5433/newsekolah?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_SIGNING_KEY=               # base64 ES256 private key; `go run ./cmd/keygen`
DOCUMENT_SIGNING_KEY=          # random secret, >=32 chars; HMAC key for issued-document verification codes, distinct from JWT_SIGNING_KEY
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=newsekolah
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
SMTP_URL=smtp://localhost:1025
WHATSAPP_PROVIDER=noop         # noop | meta | fonnte
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
VAPID_PUBLIC_KEY=              # Web Push; generate with webpush.GenerateVAPIDKeys()
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@newsekolah.invalid
APNS_KEY_P8=                   # .p8 token key contents (or APNS_KEY_P8_FILE)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=                    # iOS app bundle id
APNS_PRODUCTION=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=      # service account key JSON contents (or _FILE)
WORKER_INLINE=true             # run River workers inside cmd/api (small schools); false when cmd/worker runs separately
OPENAPI_VALIDATION=enforce     # enforce | log | off; rejects/logs requests that do not match openapi/openapi.yaml. Default: enforce outside production, log in production
MONITOR_API_TOKEN=             # shared secret for GET /internal/monitor-config (host monitor script); empty disables the endpoint (404). Generate with `openssl rand -hex 32`
# Web
NEXT_PUBLIC_API_URL=http://localhost:8080
