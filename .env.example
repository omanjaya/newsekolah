REFRESH_TOKEN_TTL=720h
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=newsekolah
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
SMTP_URL=smtp://localhost:1025
WHATSAPP_PROVIDER=noop         # noop | meta | fonnte
