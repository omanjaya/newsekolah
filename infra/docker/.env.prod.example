# Template for infra/docker/.env, the production/self-host configuration
# file. Copy this to infra/docker/.env and fill in every value -- the api
# refuses to start with an empty required secret (docs/08-security.md
# section 8). docker compose reads .env automatically both for ${VAR}
# substitution inside the compose files and, via each service's
# `env_file: .env`, as the container's own environment.
#
# Secrets: every variable below can instead be provided as a Docker/Swarm
# file secret by setting the `_FILE` variant (for example
# JWT_SIGNING_KEY_FILE=/run/secrets/jwt_signing_key) -- Postgres and MinIO
# honor `_FILE` natively; apps/api reads `_FILE` for its own settings per
# docs/08-security.md section 8. Never commit a real value to this file.
# infra/scripts/bootstrap.sh generates most secrets for you on first install.

# --- Core ------------------------------------------------------------------
APP_ENV=production
TENANCY_MODE=single
# Used by the bundled Caddy service (infra/caddy/Caddyfile) for automatic
# TLS. Not read when the stack runs behind a shared system Caddy instead
# (infra/README.md "Shared system Caddy (VPS)").
SITE_DOMAIN=sekolah-anda.sch.id
APP_ORIGINS=https://sekolah-anda.sch.id
APP_TIMEZONE=Asia/Makassar
# Only needed when TENANCY_MODE=multi (infra/README.md "Switching to
# multi-tenant SaaS mode").
BASE_DOMAIN=

# --- Postgres ----------------------------------------------------------
POSTGRES_DB=newsekolah
POSTGRES_USER=newsekolah
POSTGRES_PASSWORD=change-me
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_WORK_MEM=4MB
# Admin/superuser connection string, used only by the `migrate` service to
# apply schema migrations and create the least-privilege app_rw/app_platform
# roles (apps/api/migrations/0004_db_roles.up.sql). Must match
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above. api and worker never
# use this URL -- see APP_DB_PASSWORD.
DATABASE_URL=postgresql://newsekolah:change-me@postgres:5432/newsekolah?sslmode=disable
# Password for the app_rw role api and worker actually connect as, never the
# superuser above: a superuser (or a BYPASSRLS role) always bypasses row
# level security regardless of FORCE ROW LEVEL SECURITY, so tenant isolation
# depends on api/worker never connecting as one (docs/08-security.md
# section 4). On every `migrate up`, the migrate service sets app_rw's login
# password to this value via ALTER ROLE, so the 0004 migration's default
# password ('change-me-in-production') is never left active. Required in
# production -- `migrate` refuses to run without it when app_rw exists and
# APP_ENV=production. api and worker separately refuse to start in
# production if the role they connected as turns out to still be a
# superuser or BYPASSRLS role (apps/api/internal/platform/database).
APP_DB_PASSWORD=change-me-too

REDIS_URL=redis://redis:6379/0

# --- Application secrets -------------------------------------------------
# ES256 JWT signing key for access/refresh tokens. Generate with
# `go run ./apps/api/cmd/keygen`.
JWT_SIGNING_KEY=
# Dedicated HMAC secret for issued_documents verification codes (surat izin,
# SP, ...). Never reuse JWT_SIGNING_KEY: a compromise of one key must not
# unlock the other. At least 32 characters. Generate with
# `openssl rand -hex 32`.
DOCUMENT_SIGNING_KEY=
# Seals fields that must stay unreadable to database operators, such as BK
# counseling notes (docs/08-security.md section 5). Kept separate from
# DOCUMENT_SIGNING_KEY for the same reason that key is kept separate from
# JWT_SIGNING_KEY: a leak of the signing key (which only needs to verify
# public documents) must not also unseal confidential data. Falls back to
# DOCUMENT_SIGNING_KEY when left empty, so this is optional only for a
# single-school deployment willing to accept that shared blast radius; set
# it explicitly for anything handling real student data. Generate with
# `openssl rand -hex 32`.
DATA_ENCRYPTION_KEY=

# --- Network -------------------------------------------------------------
# Comma-separated IPs/CIDRs to trust for X-Forwarded-* headers (client IP,
# scheme). Leave empty for the bundled Caddy (it reaches api/web directly on
# the compose network, no proxy header spoofing surface to trust). Set to
# 127.0.0.1/32 when running behind a shared system Caddy on the same host
# (infra/README.md "Shared system Caddy (VPS)"), since that proxy connects
# over loopback.
TRUSTED_PROXIES=
# Max accepted request body size in bytes (default in code: 1048576 / 1 MiB).
# docs/08-security.md section 6 documents the smaller per-upload-type limits
# enforced separately (avatar, evidence photo, import file); this is only
# the outer ceiling.
BODY_LIMIT_BYTES=1048576

# --- Object storage (MinIO / S3-compatible) -------------------------------
S3_ENDPOINT=minio:9000
S3_BUCKET=newsekolah
S3_ACCESS_KEY=newsekolah
S3_SECRET_KEY=change-me
# true only when S3_ENDPOINT is TLS-terminated. Always false for the
# bundled MinIO container: it is reached over the private compose network,
# never the public internet (see docker-compose.prod.yml comments).
S3_USE_SSL=false

# --- Email -----------------------------------------------------------------
SMTP_URL=

# --- WhatsApp --------------------------------------------------------------
WHATSAPP_PROVIDER=noop
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Meta app secret, used to verify the X-Hub-Signature-256 header on the
# inbound WhatsApp status webhook. Not the same value as WHATSAPP_TOKEN.
# Optional: without it the webhook cannot be used, but per-tenant WhatsApp
# sending still works.
WHATSAPP_APP_SECRET=
# Answers Meta's GET verification handshake when first registering the
# webhook URL. Pick any random string and enter the same value in the Meta
# app dashboard's webhook configuration.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Web push (VAPID) -------------------------------------------------------
# Generate a pair with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sekolah-anda.sch.id
# Same value as VAPID_PUBLIC_KEY above, exposed to the browser: it is baked
# into the web build as a build arg (docker-compose.prod.yml web service,
# apps/web/Dockerfile), not read at container runtime, so the web image
# must be rebuilt after changing either key.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Mobile push (APNS / FCM) -----------------------------------------------
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_PRODUCTION=true
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# --- Web ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://sekolah-anda.sch.id
API_IMAGE=newsekolah-api:local
WEB_IMAGE=newsekolah-web:local
BACKUP_IMAGE=newsekolah-backup:local

# --- Backups (optional `backup` compose profile) ----------------------------
BACKUP_CRON_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# age public key (age1...) the Postgres dump is encrypted to before upload.
# Required: infra/scripts/backup.sh refuses to run without it rather than
# upload an unencrypted dump. Generate a keypair with `age-keygen` and keep
# the private key somewhere other than this server.
BACKUP_AGE_RECIPIENT=

# --- Observability -----------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
