# Reverse proxy for the single-school self-host stack (docs/02-system-design.md
# section 8). Automatic TLS via Caddy's built-in ACME client — no extra config
# needed as long as SITE_DOMAIN resolves to this host and ports 80/443 are open.
{
	# JSON access logs to stdout; `docker compose logs caddy` stays parseable.
	log {
		output stdout
		format json
	}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		# CSP is set by the api/web apps themselves (nonce-based, per
		# docs/08-security.md section 7) since it differs per response.
		-Server
	}

	# WebSocket and plain HTTP both match here; reverse_proxy upgrades
	# automatically on `Connection: Upgrade` so no separate block is needed.
	@api path /v1/* /health /ws/*
	reverse_proxy @api api:8080

	reverse_proxy web:3000

	log {
		output stdout
		format json
	}
}

