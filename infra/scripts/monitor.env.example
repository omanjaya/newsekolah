# Template for /etc/newsekolah/monitor.env, read by infra/scripts/monitor.sh
# (both the every-minute checks and the daily summary). Copy this to
# /etc/newsekolah/monitor.env, fill in at least MONITOR_API_TOKEN (or the
# Telegram credentials, if the platform console isn't wired up yet), and
# chmod 600 it -- it can hold a bot token.
#
# Precedence: anything set here always overrides the platform console's
# monitor-config API; anything left unset here falls back to that API (or
# its local cache), then to the hardcoded default noted below.

# --- Platform console integration ------------------------------------------
# apps/api exposes GET /internal/monitor-config on loopback only (not
# proxied by Caddy), returning the Telegram credentials, per-check
# enable/disable toggles, thresholds, and the daily summary's hour, all
# editable from the platform console. Set this to the same value as
# MONITOR_API_TOKEN in /root/sion/infra/docker/.env. Leave empty to run
# monitor.sh purely from this file (every value below then needs to be set
# here instead).
MONITOR_API_TOKEN=
# MONITOR_API_URL=http://127.0.0.1:8081/internal/monitor-config
# MONITOR_CONFIG_CACHE=/var/lib/newsekolah-monitor/config.json
# MONITOR_API_TIMEOUT_SECONDS=5

# --- Telegram (normally set via the platform console instead) --------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Identification ----------------------------------------------------
# Shown in every alert. Defaults to `hostname`.
# HOST_LABEL=sion-vps

# --- Thresholds (normally set via the platform console instead) ------------
# DISK_THRESHOLD_PERCENT=85
# MEM_AVAILABLE_THRESHOLD_MB=256
# BACKUP_MAX_AGE_HOURS=26
# CERT_EXPIRY_DAYS=14

# --- Per-check toggles (1/0; normally set via the platform console) --------
# CHECK_HEALTH_ENABLED=1
# CHECK_CONTAINERS_ENABLED=1
# CHECK_DISK_ENABLED=1
# CHECK_MEMORY_ENABLED=1
# CHECK_BACKUP_ENABLED=1
# CHECK_CERTIFICATE_ENABLED=1
# CHECK_ERRORS_ENABLED=1

# --- Daily summary (normally set via the platform console) -----------------
# DAILY_SUMMARY_ENABLED=1
# DAILY_SUMMARY_HOUR_WITA=7

# --- Local-only settings (not part of the platform console's config) -------
# CONTAINER_RESTART_THRESHOLD=5
# ERROR_BURST_THRESHOLD=20
# ALERT_REPEAT_SECONDS=21600
# CURL_TIMEOUT_SECONDS=10
# STATE_DIR=/var/lib/newsekolah-monitor

# PROD_API_LOOPBACK_URL=http://127.0.0.1:8081/health
# STAGING_API_LOOPBACK_URL=http://127.0.0.1:8082/health
# PROD_PUBLIC_HEALTH_URL=https://sion.nouma.id/health
# STAGING_PUBLIC_HEALTH_URL=https://staging.sion.nouma.id/health
# PROD_SITE_HOST=sion.nouma.id
# STAGING_SITE_HOST=staging.sion.nouma.id

# PROD_COMPOSE_DIR=/root/sion/infra/docker
# PROD_COMPOSE_FILES=docker-compose.prod.yml compose.vps.yml
# PROD_COMPOSE_PROJECT=newsekolah
# STAGING_COMPOSE_DIR=/root/sion-staging/infra/docker
# STAGING_COMPOSE_FILES=docker-compose.prod.yml compose.staging.yml
# STAGING_COMPOSE_PROJECT=newsekolah-staging

# BACKUP_LAST_SUCCESS_FILE=/root/backups/newsekolah/LAST_SUCCESS
