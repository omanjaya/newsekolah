# API origin the browser and server both call. Must be reachable from the browser too:
# the access token lives in memory only, so every request (including the boot-time
# refresh) goes straight from the browser to this origin with credentials: "include".
NEXT_PUBLIC_API_URL=http://localhost:8080
API_INTERNAL_URL=http://localhost:8080

# VAPID public key for Web Push, the same key pair the API signs with
# (VAPID_PUBLIC_KEY there). It identifies the server to the push service
# and is meant to be public. Leave it empty and the browser-notification
# switch never appears, which is what a deployment without push wants.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# The rebuild is still in its test period (docs/15-paritas-sion.md): leave
# this unset (or anything other than "true") so app/robots.ts disallows all
# crawling and every page carries a noindex, nofollow directive. Set to
# "true" only once the deployment is ready for search engines.
NEXT_PUBLIC_ALLOW_INDEXING=
